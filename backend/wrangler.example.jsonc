// Copy to wrangler.jsonc (gitignored) and fill in the ids printed by:
//   npx wrangler d1 create eidetic
//   npx wrangler kv namespace create eidetic-oauth
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eidetic",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // workers-oauth-provider's token/client store. Binding name is fixed by the library.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<kv-namespace-id>" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eidetic",
      "database_id": "<d1-database-id>",
      "migrations_dir": "migrations"
    }
  ]
  // Secret (not in this file): APP_TOKEN — `wrangler secret put APP_TOKEN`; locally in .dev.vars.
}
